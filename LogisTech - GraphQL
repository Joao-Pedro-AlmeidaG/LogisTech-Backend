        {
          "name": "Login Gestor",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();\nif (json.data && json.data.login && json.data.login.token) {\n    pm.collectionVariables.set('token', json.data.login.token);\n    pm.collectionVariables.set('userId', json.data.login.usuario._id);\n}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation LoginUser {\n  login(\n    email: \"pedro@logistech.com\", \n    senha: \"123456\"\n  ) {\n    token\n    usuario {\n      _id\n      nome\n      email\n      perfil\n    }\n  }\n}"
              }
            },
            "url": {
              "raw": "http://localhost:3000/api/auth/login",
